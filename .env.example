APP_NAME="JEJAK WANGI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Produksi: APP_ENV=production, APP_DEBUG=false (debug=true membocorkan pesan galat internal ke klien).
# CORS: domain FE yang boleh memanggil API, dipisah koma (pola LAN hanya aktif saat APP_ENV=local).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Masa berlaku token login (menit). Default 43200 = 30 hari.
SANCTUM_EXPIRATION=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeder akun admin (wajib diisi di produksi; di lokal default admin@jejakwangi.id / jejakwangi123).
# Sandi hanya diatur saat akun dibuat, db:seed berikutnya tidak mengubahnya.
# ADMIN_SEED_EMAIL=admin@jejakwangi.id
# ADMIN_SEED_PASSWORD=

# Login sosial (opsional). Kosongkan penyedia yang tidak dipakai — tombolnya otomatis hilang di FE.
# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=63243836153-fiep8b27utiqo0j4ol5mh5nsqbcdt2dt.apps.googleusercontent.com
# Facebook: Meta for Developers > App > Facebook Login (izin: public_profile, email)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Eco-Coach (AI). API key hanya di server. Kosongkan LLM_PROVIDER = template cadangan tanpa AI.
# LLM_PROVIDER=anthropic -> ANTHROPIC_API_KEY, LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=openai    -> OPENAI_API_KEY, LLM_BASE_URL (endpoint kompatibel OpenAI), LLM_MODEL
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000

# ISPU/suhu dari Open-Meteo (gratis, tanpa key). off | auto (sensor ESP32 diutamakan) | openmeteo (selalu Open-Meteo)
OPENMETEO_MODE=auto
# OPENMETEO_DEFAULT_KORIDOR_ID=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
